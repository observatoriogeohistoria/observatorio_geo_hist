# Versioned and uploaded on every deploy, replacing the server's copy. Don't add cPanel-generated
# blocks (PHP handler, password-protected directories): the next deploy would erase them.
# The dev deploy appends the password and X-Robots-Tag (see deploy-dev.yml).

DirectoryIndex index.html

# Hidden files (.git, .github, deploy sync state) must never be served; .well-known stays open for certificate renewal.
RedirectMatch 404 /\.(?!well-known)

RewriteEngine On
RewriteBase /

# www and plain http go to the bare https address in a single hop.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# App routes (Flutter without #): anything that is not a file or folder goes to index.html.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/wasm image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/wasm image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Flutter keeps the same file names on every build; a long cache would serve the old version after a deploy.
  Header set Cache-Control "no-cache"
  Header append Vary Accept-Encoding

  # No includeSubDomains yet: curadoria and geoensine also live under this domain.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
</IfModule>
